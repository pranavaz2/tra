# =============================================================================
# Travix AI — Environment Configuration (.env)
# =============================================================================
# Copy this file to `apps/api/.env` for local backend development.
# Real secrets must never be committed to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & SECURITY (REQUIRED)
# -----------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=true
APP_NAME="Travix AI"
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000

# Secret keys for JWT auth and session signing.
# In production, generate random 64-character strings:
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="travix-development-secret-key-minimum-32-characters-12345"
JWT_SECRET_KEY="travix-jwt-development-secret-key-minimum-32-characters-12345"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER="https://api.travix.ai"
JWT_AUDIENCE="travix-mobile"

# -----------------------------------------------------------------------------
# 2. DATABASE — PostgreSQL (REQUIRED)
# -----------------------------------------------------------------------------
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travix_dev

# Sync URL used for Alembic database migrations
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/travix_dev

# -----------------------------------------------------------------------------
# 3. REDIS — Cache & WebSocket Presence (OPTIONAL FOR DEV)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# 4. EXTERNAL AI & MAPS PROVIDERS (OPTIONAL)
# If left empty, Travix AI automatically uses built-in deterministic mocks!
# -----------------------------------------------------------------------------

# Google Gemini AI (For real AI itinerary generation and conversational assistant)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Google Maps & Places (For verified places search, ratings, and route transit times)
# Get a key at: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# -----------------------------------------------------------------------------
# 5. WEATHER & PUSH NOTIFICATIONS (FREE — NO API KEYS NEEDED)
# -----------------------------------------------------------------------------
# Weather uses Open-Meteo free public API (No key required)
# Push Notifications use standard Expo Push gateway (No key required)
