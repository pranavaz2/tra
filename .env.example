# =============================================================================
# Travix AI — .env.example
#
# This file documents every environment variable used by the system.
# Copy this file to .env for local development and fill in real values.
#
# NEVER commit .env to version control.
# NEVER put real secrets in this file.
#
# Variable naming convention: SCREAMING_SNAKE_CASE, grouped by service.
# All variables are consumed by apps/api/app/config.py (Pydantic BaseSettings).
# =============================================================================


# =============================================================================
# APPLICATION
# =============================================================================

# Environment name: development | staging | production
APP_ENV=development

# Enable debug mode (never true in production)
APP_DEBUG=true

# Application name (used in logs and error messages)
APP_NAME=Travix AI

# Application version (injected at build time in CI)
APP_VERSION=0.0.1

# API host and port for local development
API_HOST=0.0.0.0
API_PORT=8000

# Root URL of the API (used for constructing absolute URLs in responses)
API_BASE_URL=http://localhost:8000


# =============================================================================
# SECURITY
# =============================================================================

# Secret key used for general cryptographic signing (generate with: openssl rand -hex 32)
SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32

# Allowed CORS origins (comma-separated). Use * only in development.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Allowed CORS methods
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed CORS headers
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept


# =============================================================================
# JWT AUTHENTICATION
# =============================================================================

# Secret key for signing JWT tokens (separate from APP_SECRET_KEY)
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=CHANGE_ME_generate_with_openssl_rand_hex_64

# JWT signing algorithm
JWT_ALGORITHM=HS256

# Access token expiry in minutes (recommended: 15)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh token expiry in days (recommended: 7)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7


# =============================================================================
# DATABASE — PostgreSQL + PostGIS
# =============================================================================

# Full async DSN for SQLAlchemy (uses asyncpg driver)
DATABASE_URL=postgresql+asyncpg://travix:travix_password@localhost:5432/travix_db

# Synchronous DSN for Alembic migrations (uses psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://travix:travix_password@localhost:5432/travix_db

# PostgreSQL connection details (used by Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=travix_db
POSTGRES_USER=travix
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password

# SQLAlchemy connection pool configuration
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30


# =============================================================================
# REDIS
# =============================================================================

# Redis connection URL
REDIS_URL=redis://localhost:6379/0

# Redis host and port (used by Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis database number for the task queue (separate from cache)
REDIS_TASK_QUEUE_DB=1

# Redis database number for token revocation
REDIS_TOKEN_REVOCATION_DB=2

# Default cache TTL in seconds (5 minutes)
REDIS_DEFAULT_TTL=300


# =============================================================================
# AI PROVIDER
# =============================================================================

# Active AI provider: openai | anthropic | mock
# Use "mock" for local development to avoid API costs
AI_PROVIDER=mock

# API key for the active AI provider
AI_API_KEY=CHANGE_ME_your_ai_provider_api_key

# Model identifier (provider-specific)
# OpenAI examples: gpt-4o, gpt-4o-mini
# Anthropic examples: claude-opus-4-8, claude-sonnet-4-6
AI_MODEL=CHANGE_ME_your_preferred_model

# Maximum tokens per AI response
AI_MAX_TOKENS=4096

# AI request timeout in seconds
AI_TIMEOUT_SECONDS=60

# Maximum retries on AI provider failure
AI_MAX_RETRIES=3


# =============================================================================
# MAPS — Google Maps Platform
# =============================================================================

# Active maps provider: google | mock
MAPS_PROVIDER=mock

# Server-side Google Maps API key (Geocoding, Places, Directions APIs)
# This key is NEVER sent to the client. Restrict by server IP in Google Cloud Console.
GOOGLE_MAPS_SERVER_API_KEY=CHANGE_ME_your_server_side_maps_api_key

# Client-side Google Maps API key (Maps SDK for Android/iOS)
# This key is used in the Flutter app. Restrict by Android SHA-1 and iOS Bundle ID.
GOOGLE_MAPS_CLIENT_API_KEY=CHANGE_ME_your_client_side_maps_api_key


# =============================================================================
# WEATHER — Open-Meteo
# =============================================================================

# Open-Meteo is free and requires no API key for standard use.
# Set a custom base URL only if using the commercial plan.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Weather data cache TTL in seconds (30 minutes recommended)
WEATHER_CACHE_TTL=1800


# =============================================================================
# EMAIL — Resend (future)
# =============================================================================

# Active email provider: resend | mock
EMAIL_PROVIDER=mock

# Resend API key
# TODO: Add when Resend integration is implemented
RESEND_API_KEY=CHANGE_ME_your_resend_api_key

# From address for transactional emails
EMAIL_FROM_ADDRESS=noreply@travixai.com
EMAIL_FROM_NAME=Travix AI


# =============================================================================
# STORAGE — Cloudflare R2 (future)
# =============================================================================

# Active storage provider: r2 | s3 | mock
STORAGE_PROVIDER=mock

# Cloudflare R2 credentials
# TODO: Add when R2 integration is implemented
R2_ACCOUNT_ID=CHANGE_ME_your_cloudflare_account_id
R2_ACCESS_KEY_ID=CHANGE_ME_your_r2_access_key_id
R2_SECRET_ACCESS_KEY=CHANGE_ME_your_r2_secret_access_key
R2_BUCKET_NAME=travix-ai-assets
R2_PUBLIC_URL=https://assets.travixai.com

# Maximum file upload size in bytes (10 MB)
STORAGE_MAX_FILE_SIZE=10485760


# =============================================================================
# PUSH NOTIFICATIONS — Firebase Cloud Messaging (future)
# =============================================================================

# Active notification provider: fcm | mock
NOTIFICATION_PROVIDER=mock

# Path to the Firebase service account JSON key file
# TODO: Add when FCM integration is implemented
FIREBASE_SERVICE_ACCOUNT_PATH=CHANGE_ME_path_to_service_account_json

# Firebase project ID
FIREBASE_PROJECT_ID=CHANGE_ME_your_firebase_project_id


# =============================================================================
# TASK QUEUE — ARQ
# =============================================================================

# ARQ worker concurrency (number of concurrent jobs)
ARQ_WORKER_CONCURRENCY=10

# Maximum job retry attempts
ARQ_MAX_RETRIES=3

# Job timeout in seconds (90 seconds — covers slow AI calls)
ARQ_JOB_TIMEOUT=90


# =============================================================================
# LOGGING
# =============================================================================

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=DEBUG

# Log format: json | text
# Use json in production for structured log aggregation
LOG_FORMAT=text


# =============================================================================
# RATE LIMITING
# =============================================================================

# Requests per minute for public endpoints
RATE_LIMIT_PUBLIC_RPM=60

# Requests per minute for authenticated endpoints
RATE_LIMIT_AUTH_RPM=120

# Requests per minute for AI-backed endpoints (protects budget)
RATE_LIMIT_AI_RPM=10
